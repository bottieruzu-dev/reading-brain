import { C, GRAD_BG, GRAD_MAIN, R } from '../lib/theme';

export function Screen({ children }: any) {
  return (
    <View style={{ flex: 1, backgroundColor: C.bg }}>
      <LinearGradient
        colors={GRAD_BG}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
        style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 380 }}
      />
      {children}
    </View>
