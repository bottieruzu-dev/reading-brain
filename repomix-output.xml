          <Ionicons name="add" size={30} color="#0B0A14" />
        </LinearGradient>
      </Press>

      <AddBookSheet visible={open} onClose={() => setOpen(false)} onDone={(msg: string) => toast.show(msg)} addBook={addBook} />
      {toast.node}
    </Screen>
