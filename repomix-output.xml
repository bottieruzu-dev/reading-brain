                        {'★'.repeat(item.priority)}
                      </Text>
                    )}
                  </View>
                  <Text style={{ color: C.sub, fontSize: 10.5, fontWeight: '700' }}>📝 {countOf(item.id)}</Text>
                </View>

                {/* ワンタップ昇格ボタン（読みたい ➔ 読書中） */}
