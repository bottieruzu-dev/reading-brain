                  <Pressable
                    onPress={async (e) => {
                      e.stopPropagation();
                      await updateBook(item.id, { status: 'reading' });
                      toast.show('「読書中」に変更しました！');
                    }}
                    style={{
                      backgroundColor: C.primary,
                      paddingVertical: 6,
                      borderRadius: R.pill,
                      alignItems: 'center',
                      marginTop: 8,
                    }}
                  >
                    <Text style={{ color: '#0B0A14', fontWeight: '900', fontSize: 11 }}>📖 読書を開始する</Text>
                  </Pressable>
                )}
              </View>
